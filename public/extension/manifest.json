{
  "manifest_version": 3,
  "name": "ChatGPT HTML Extractor",
  "version": "1.1",
  "description": "Background extractor for ChatGPT share links — part of Seamless Bridge",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.replit.dev/*",
        "https://*.replit.app/*",
        "https://*.run.app/*",
        "https://*.onrender.com/*",
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content-inject.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.replit.dev/*",
      "https://*.replit.app/*",
      "https://*.run.app/*",
      "https://*.onrender.com/*",
      "http://localhost:5000/*",
      "http://127.0.0.1:5000/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  }
}
